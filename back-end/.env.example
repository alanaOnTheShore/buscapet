# Copie para .env (o .env NÃO vai para o GitHub)
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Banco (string de conexão do Neon/Supabase ou do PostgreSQL local)
# Dica: troque 'sslmode=require' por 'sslmode=verify-full' (mesmo comportamento; some o aviso de SSL do driver)
# e apague '&channel_binding=require' se vier na string do Neon.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=verify-full

# Assinatura da sessão. Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres

# Pasta das fotos (padrão: back-end/uploads)
# UPLOAD_DIR=

# E-mail de recuperação de senha (sem SMTP_HOST, o link aparece no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BuscaPet <seu-email@exemplo.com>

# Banco SEPARADO usado só pelos testes automatizados (npm test) - NUNCA o banco real
TEST_DATABASE_URL=postgresql://usuario:senha@host:5432/banco_teste?sslmode=verify-full
